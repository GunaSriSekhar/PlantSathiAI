# PlantSathi AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# REQUIRED — Application Settings
# ============================================================
APP_NAME="PlantSathi AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# ============================================================
# SERVER SETTINGS
# ============================================================
HOST="0.0.0.0"
PORT=8000

# ============================================================
# CORS SETTINGS
# Comma-separated list of allowed origins
# In production, replace with your actual frontend URL
# ============================================================
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ============================================================
# DATABASE
# SQLite is used by default. For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://user:password@host:5432/plantsathi"
# ============================================================
DATABASE_URL="sqlite+aiosqlite:///./plantsathi.db"

# ============================================================
# UPLOAD SETTINGS
# ============================================================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"

# ============================================================
# PLANT IDENTIFICATION MODEL
# Using HuggingFace transformers pipeline (local, no API key)
# Model auto-downloads from HuggingFace Hub on first run (~80MB)
# ============================================================
PLANT_ID_MODEL="umutbozdag/plant-identity"
PLANT_ID_CONFIDENCE_THRESHOLD=0.15

# ============================================================
# DISEASE DETECTION MODEL
# PlantVillage-trained MobileNetV2 (local, no API key)
# Model auto-downloads from HuggingFace Hub on first run (~14MB)
# ============================================================
DISEASE_MODEL="linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification"
DISEASE_CONFIDENCE_THRESHOLD=0.40

# ============================================================
# OPTIONAL: PLANTNET API (for improved plant identification)
# Get a free key at: https://my.plantnet.org/
# 500 requests/day on free tier
# Leave blank to use local HuggingFace model only
# ============================================================
PLANTNET_API_KEY=""
PLANTNET_API_URL="https://my-api.plantnet.org/v2/identify/all"

# ============================================================
# OPTIONAL: GOOGLE GEMINI API (for AI Plant Doctor)
# Get a free key at: https://aistudio.google.com/
# Free tier: 15 RPM, 1M tokens/day
# Leave blank to use rule-based fallback
# ============================================================
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ============================================================
# MODEL CACHE
# Where HuggingFace models are cached locally
# ============================================================
HF_HOME="./model_cache"
TRANSFORMERS_CACHE="./model_cache/transformers"

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL="INFO"
LOG_FILE="./logs/plantsathi.log"
